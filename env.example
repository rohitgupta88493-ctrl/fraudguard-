# ─────────────────────────────────────────────────────────────
# ShieldAI Fraud Detection — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Node.js Backend ────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# JWT Secret — generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars

# ── Database ───────────────────────────────────────────────────
# MongoDB Atlas (cloud):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shieldai

# PostgreSQL (alternative):
# DATABASE_URL=postgresql://user:password@localhost:5432/shieldai

# ── ML Service ─────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (Gmail SMTP) ─────────────────────────────────────────
# Enable "Less Secure Apps" or use App Password for Gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ── React Frontend ─────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_APP_NAME=ShieldAI

# ── Python ML Service ──────────────────────────────────────────
MODEL_PATH=models/fraud_model.pkl
SCALER_PATH=models/scaler.pkl
ENCODER_PATH=models/label_encoder.pkl

# ── Optional: PDF Generation ───────────────────────────────────
# WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf

# ── Optional: SMS Alerts (Twilio) ─────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE=+1234567890
